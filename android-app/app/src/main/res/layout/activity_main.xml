<?xml version="1.0" encoding="utf-8"?>
<!-- V3.2 主界面（docs/ui-design/v3/android.html）：brand 行 + 状态胶囊 + 中央态区 + 设备芯片 + PTT -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- brand 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp">

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_brand"
            android:gravity="center"
            android:text="RV"
            android:textColor="@color/rv_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_name"
                android:textColor="@color/rv_tx"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="@string/brand_sub"
                android:textColor="@color/rv_tx2"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_iconbtn"
            android:contentDescription="@string/label_settings"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="@color/rv_tx2" />
    </LinearLayout>

    <!-- 状态胶囊：点按连接/停止/重试 -->
    <LinearLayout
        android:id="@+id/status_capsule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_capsule"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/led"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="11dp"
            android:background="@drawable/bg_led" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/status_default"
                android:textColor="@color/rv_tx"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/rv_tx2"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中央态区：大字 / 转圈 / 波形+计时+帧数 / 错误面板 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/spin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/rv_blue"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/big_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/big_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="@string/big_idle_t1"
                android:textColor="@color/rv_tx"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/big_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/big_idle_t2"
                android:textColor="@color/rv_tx2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/live_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.remotevoice.app.WaveView
                android:id="@+id/wave"
                android:layout_width="220dp"
                android:layout_height="72dp" />

            <TextView
                android:id="@+id/text_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="00:00"
                android:textColor="@color/rv_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_frames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="已发送 0 帧 · 48kHz"
                android:textColor="@color/rv_tx2"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/err_panel"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_errpanel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_err_title"
                android:textColor="@color/rv_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_err"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/rv_tx2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_iconbtn"
                android:minWidth="120dp"
                android:text="@string/btn_retry"
                android:textColor="@color/rv_tx" />

            <!-- 证书更换专用：清除本机记录并重新连接（PLAN-025，默认隐藏） -->
            <Button
                android:id="@+id/btn_retrust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_iconbtn"
                android:minWidth="160dp"
                android:text="重新信任并重连"
                android:textColor="@color/rv_tx"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 设备芯片（单选激活） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/devices_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- PTT：按住即传、松开即停 -->
    <Button
        android:id="@+id/btn_ptt"
        android:layout_width="172dp"
        android:layout_height="172dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ptt"
        android:stateListAnimator="@null"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/ptt_hint"
        android:textColor="@color/rv_tx"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="9dp"
        android:background="@color/rv_line" />
</LinearLayout>
