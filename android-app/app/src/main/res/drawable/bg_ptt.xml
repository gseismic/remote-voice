<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#2E3B2E" android:endColor="#15241A" />
            <stroke android:width="2dp" android:color="@color/rv_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#28313F" android:endColor="#151B24" />
            <stroke android:width="1dp" android:color="#3D4756" />
        </shape>
    </item>
</selector>
